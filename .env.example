# Database Settings
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=judge_db

# JWT Authentication Secret (MUST BE CHANGED IN PRODUCTION)
# Ensure this is a strong, Base64-encoded string (at least 48 bytes for HS384)
JWT_SECRET=your_base64_encoded_secret_key_here_at_least_48_bytes_for_hs384

# Other Services
MINIO_ROOT_USER=your_minio_admin_user_here
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
RABBITMQ_DEFAULT_USER=your_rabbitmq_user_here
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password_here
